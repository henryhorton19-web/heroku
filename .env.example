# Copy to .env and fill in. .env is gitignored; never commit it.
ARB_DB_PATH=arb.db
ARB_DATA_DIR=data

# Vinted. Automated access is against their terms; the exposure is the account,
# so keep this separate from anything you cannot afford to lose.
ARB_VINTED_BASE_URL=https://www.vinted.co.uk
ARB_VINTED_REQUESTS_PER_SECOND=1.5

# Credentials. All optional: absent means that step is unavailable, not broken.
ARB_SOLDCOMPS_API_KEY=
ARB_APIFY_TOKEN=
ARB_ANTHROPIC_API_KEY=
ARB_EBAY_REST_CONFIG=ebay_rest.json

# Precision over recall: refuse to estimate below this many comps.
ARB_MIN_COMP_N=3
